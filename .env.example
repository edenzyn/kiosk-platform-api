NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiosk-dev
DATABASE_SSL_MODE=disable
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_INVITE_USER_SECRET=replace-with-invite-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_DEVICE_ACCESS_EXPIRES_IN=15m
JWT_DEVICE_REFRESH_EXPIRES_IN=90d
JWT_INVITE_USER_EXPIRES_IN=7d
ONE_TIME_TOKEN_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SLIDING_ENABLED=true
BCRYPT_ROUNDS=12
API_PREFIX_V1=/api/v1
CORS_ORIGIN_1=http://localhost:5000
CORS_ORIGIN_2=
USER_CLIENT_BASE_URL=http://localhost:5000
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=100
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Kiosk Platform" <noreply@kioskplatform.com>
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
META_WHATSAPP_VERIFY_TOKEN=your_own_webhook_verify_token
META_WHATSAPP_APP_SECRET=your_meta_app_secret
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_API_BASE_URL=https://graph.facebook.com
NORMAL_USER_SESSION_LIMIT=1
RESELLER_USER_SESSION_LIMIT=5
PLATFORM_USER_SESSION_LIMIT=5
IS_NORMAL_SESSION_AUTO_LOGOUT_ENABLED=true
IS_RESELLER_SESSION_AUTO_LOGOUT_ENABLED=true
IS_PLATFORM_SESSION_AUTO_LOGOUT_ENABLED=true
REDIS_URL=redis://localhost:6379
LICENSE_ENCRYPTION_KEY=ssdada
LICENSE_GRACE_PERIOD_DAYS=7
AUTH_SESSION_CLEANUP_CRON=0 4 * * *
LICENSE_STATUS_CHECK_CRON=0 */6 * * *
ONE_TIME_TOKEN_CLEANUP_CRON=0 * * * *

