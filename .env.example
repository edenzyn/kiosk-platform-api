NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiosk-dev
DATABASE_SSL_MODE=disable
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_INVITE_SECRET=replace-with-invite-32-character-secret
JWT_2FA_SECRET=replace-with-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_INVITE_EXPIRES_IN=7d
JWT_2FA_OTP_EXPIRES_IN=10m
JWT_2FA_TOTP_SETUP_EXPIRES_IN=10m
JWT_2FA_PENDING_LOGIN_EXPIRES_IN=5m
JWT_REFRESH_SLIDING_ENABLED=true
BCRYPT_ROUNDS=12
API_PREFIX_V1=/api/v1
CORS_ORIGIN_1=http://localhost:5000
CORS_ORIGIN_2=
FRONTEND_BASE_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=100
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Kiosk Platform" <noreply@kioskplatform.com>
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
LICENSE_ENCRYPTION_KEY=ssdada
LICENSE_GRACE_PERIOD_DAYS=7
REFRESH_TOKEN_CLEANUP_CRON=0 4 * * *
LICENSE_STATUS_CHECK_CRON=0 */6 * * *

