{
  "name": "kiosk-platform-api",
  "version": "1.0.0",
  "description": "Modular monolith API for the kiosk platform",
  "homepage": "https://github.com/edenzyn/kiosk-platform-client#readme",
  "bugs": {
    "url": "https://github.com/edenzyn/kiosk-platform-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edenzyn/kiosk-platform-client.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx ./src/db/seeds/add-permissions-seed.ts",
    "db:seed:platform": "tsx ./src/db/seeds/platform-user-seed.ts",
    "db:seed:basic": "tsx ./src/db/seeds/basic-data-seed.ts"
  },
  "dependencies": {
    "awesome-phonenumber": "^7.8.0",
    "awilix": "^13.0.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
